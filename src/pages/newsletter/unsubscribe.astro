---
export const prerender = false;

import { unsubscribeByToken } from '../../lib/subscribers';
import { setResendSubscribed } from '../../lib/audience';

let token = Astro.url.searchParams.get('token') ?? '';
let state: 'prompt' | 'error' = 'prompt';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  token = String(form.get('token') ?? '');
  if (!token) {
    state = 'error';
  } else {
    try {
      const res = await unsubscribeByToken(token);
      if (res.result === 'unsubscribed') {
        await setResendSubscribed({
          email: res.email!,
          contactId: res.resendContactId,
          subscribed: false,
        });
        return Astro.redirect('/unsubscribed');
      }
      if (res.result === 'already') return Astro.redirect('/unsubscribed');
      state = 'error';
    } catch {
      state = 'error';
    }
  }
}
if (!token && state === 'prompt') state = 'error';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Unsubscribe</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #fafaf7;
        color: #0f0f12;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
      .card {
        max-width: 440px;
        margin: 24px;
        padding: 40px 32px;
        background: #fff;
        border: 1px solid #e5e3db;
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(15, 15, 18, 0.08);
        text-align: center;
      }
      .mark {
        display: inline-grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: #0f0f12;
        color: #fff;
        font-weight: 600;
        margin-bottom: 16px;
      }
      h1 {
        font-size: 22px;
        margin: 0 0 10px;
      }
      p {
        color: #5a5a62;
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 24px;
      }
      .btn {
        display: inline-block;
        background: #0f0f12;
        color: #fff;
        text-decoration: none;
        padding: 12px 22px;
        border: none;
        border-radius: 6px;
        font-size: 15px;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <span class="mark">NS</span>
      {
        state === 'error' ? (
          <>
            <h1>Link invalid</h1>
            <p>This unsubscribe link is no longer valid.</p>
            <a class="btn" href="/">Back to site</a>
          </>
        ) : (
          <>
            <h1>Unsubscribe</h1>
            <p>Click below to stop receiving the weekly newsletter. No hard feelings.</p>
            <form method="POST">
              <input type="hidden" name="token" value={token} />
              <button class="btn" type="submit">Unsubscribe</button>
            </form>
          </>
        )
      }
    </main>
  </body>
</html>
