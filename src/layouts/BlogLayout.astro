---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}
const { title, description, canonicalPath = '/blog' } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="blog-header">
    <div class="container blog-header-inner">
      <a class="brand" href="/">
        <span class="brand-mark">{site.brandInitials}</span>
        <span class="brand-name">{site.name}</span>
      </a>
      <nav class="blog-nav" aria-label="Primary">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
      </nav>
    </div>
  </header>
  <main id="main"><slot /></main>
  <Footer />
</BaseLayout>

<style>
  .blog-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 247, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .blog-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
  }
  .blog-nav {
    display: flex;
    gap: var(--sp-5);
  }
  .blog-nav a {
    font-size: var(--text-sm);
    color: var(--ink-3);
    font-weight: var(--fw-medium);
  }
  .blog-nav a:hover {
    color: var(--ink);
  }
</style>
