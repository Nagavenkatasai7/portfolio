---
import { site } from '../data/content';
---
<section class="cta surface-band">
  <div class="container">
    <div class="cta-grid reveal">
      <span class="eyebrow">Ready for the next system</span>
      <h2>I am looking for engineering teams building trusted, scalable cloud products.</h2>
      <p class="role-list">
        Open to Software Engineer and Business Systems Analyst – AI Automation roles.
      </p>
      <div class="cta-actions">
        <a class="button button-primary" href={`mailto:${site.email}`}>Email me</a>
        <a class="button button-outline" href={site.calendar} target="_blank" rel="noopener">
          Schedule a call →
        </a>
      </div>
    </div>
  </div>
</section>
