# Copy this file to ".env.local" and fill in your keys.
# ".env.local" is gitignored — never commit real values.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ---- Supabase (Phase B) ------------------------------------------------------
# These are injected automatically once the `supabase-citron-school` resource
# is connected to this Vercel project (then `vercel env pull .env.local`).
# The app talks to Supabase over HTTPS via these — NOT via POSTGRES_URL (which
# on this project belongs to the separate Neon integration).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only; never exposed to the browser
# Direct Postgres connection string for migrations only (psql). Prefer the
# Supabase "non-pooling" URL. Guarded to a supabase host by scripts/apply-migrations.mjs.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Admin auth (Phase B) — GitHub OAuth, single user ------------------------
# Register a GitHub OAuth App; callback URL must be <deployment-origin>/api/auth/callback.
GITHUB_OAUTH_CLIENT_ID=your-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-oauth-app-client-secret
ADMIN_GITHUB_ID=1234567          # your NUMERIC GitHub user id (not username): https://api.github.com/users/<login>
SESSION_SECRET=generate-a-long-random-string   # e.g. `openssl rand -hex 32`
