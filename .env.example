# Copy to .env.local for local development. Never commit real values.

# Powers "Ask about my work" and "Job-fit check" (free OpenRouter models).
# Without it, both features run in their offline fallback mode.
OPENROUTER_API_KEY=

# Optional: comma-separated override of the free-model fallback chain.
# OPENROUTER_MODELS=openai/gpt-oss-120b:free,google/gemma-4-31b-it:free

# Optional: URL of the finance-Llama Hugging Face Space (see space/README.md),
# e.g. https://venkat9990-finance-llama-demo.hf.space
HF_SPACE_URL=
