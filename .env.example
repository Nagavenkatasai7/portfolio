# =============================================================================
# Environment variables. Copy to .env.local for local dev, and set the same keys
# in Vercel → Project Settings → Environment Variables for production.
# Pull Vercel values locally with: vercel env pull .env.local
# NEVER commit real secrets. See ~/Desktop/portfolio-rebuild-plan.md §7.
# =============================================================================

# ---- Database (auto-created by the Vercel–Neon integration) ----
DATABASE_URL=                 # pooled connection — use in serverless functions
DATABASE_URL_UNPOOLED=        # direct connection — migrations / db/schema.sql only

# ---- Public site config ----
PUBLIC_SITE_URL=https://chennunagavenkatasai.com

# ---- Auth (Phase 3: Google sign-in, locked to one email) ----
ADMIN_EMAIL=chennunagavenkatasai@gmail.com
AUTH_SECRET=                  # openssl rand -hex 32
AUTH_URL=https://chennunagavenkatasai.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_SEGMENT_ID=            # confirmed-subscribers segment (verify segment vs audience id)
RESEND_WEBHOOK_SECRET=        # whsec_... Svix signing secret for the webhook (Phase 9)
NEWSLETTER_FROM=Naga Venkata Sai Chennu <newsletter@chennunagavenkatasai.com>
NEWSLETTER_REPLY_TO=chennunagavenkatasai@gmail.com
CONTACT_TO=chennunagavenkatasai@gmail.com
NEWSLETTER_POSTAL_ADDRESS=    # CAN-SPAM physical address for the email footer

# ---- AI drafting (Phase 7) ----
ANTHROPIC_API_KEY=

# ---- Cron (Phase 7) ----
CRON_SECRET=                  # random >= 16 chars; Vercel sends it as Bearer

# ---- Spam protection ----
PUBLIC_TURNSTILE_SITE_KEY=    # client-exposed (PUBLIC_ prefix)
TURNSTILE_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
